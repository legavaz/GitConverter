#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() И Не ЗначениеЗаполнено(Объект.Состояние) Тогда
		Объект.Состояние = Перечисления.ноСостоянияВременныхБаз.Свободна;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	ЗаполнитьИмяБазыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КластерПриИзменении(Элемент)
	
	ЗаполнитьИмяБазыНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьБазу(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала запишите элемент.'"));
		Возврат;
	КонецЕсли;

	Результат = СоздатьБазуНаСервере();
	Если Не Результат.Успешно Тогда
		ПоказатьПредупреждение(, СтрЗаменить(НСтр("ru='Не удалось создать базу: %1'"), "%1", Результат.Описание));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(Результат.Описание);

КонецПроцедуры

&НаКлиенте
Процедура СделатьПользователяХранилища(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru='Сначала запишите элемент.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Хранилище) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не указано хранилище конфигураций.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ИмяПользователяХранилища)
			Или НЕ ЗначениеЗаполнено(Объект.ПарольПользователяХранилища) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Укажите имя и пароль пользователя хранилища.'"));
		Возврат;
	КонецЕсли;

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеВопросаОбАдминистраторе", ЭтотОбъект);
	ПоказатьВопрос(ОповещениеОЗавершении,
		НСтр("ru='Создать пользователя хранилища с правами администратора?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбАдминистраторе(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Администратор = РезультатВопроса = КодВозвратаДиалога.Да;

	Результат = СделатьПользователяХранилищаНаСервере(Объект.ИмяПользователяХранилища,
		Объект.ПарольПользователяХранилища, Администратор);
	Если Не Результат.Успешно Тогда
		ТекстОшибки = СтрЗаменить(НСтр("ru='Не удалось создать пользователя хранилища: %1'"),
			"%1", Результат.Описание);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(Результат.Описание);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СоздатьБазуНаСервере()

	Возврат ноСозданиеБазы.СоздатьБазу(Объект.Ссылка);

КонецФункции

&НаСервере
Функция СделатьПользователяХранилищаНаСервере(Знач ИмяПользователя, Знач ПарольПользователя, Знач Администратор)

	Результат = КонвертацияХранилища.ДобавитьПользователяХранилища(Объект.Ссылка, Администратор);
	Если Результат.Успешно Тогда
		// Обновляем реквизит в объекте формы, чтобы последующая запись элемента
		// не затёрла ссылку на созданного пользователя.
		Объект.ПользовательХранилища = Результат.ПользовательХранилища;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьИмяБазыНаСервере()
	
	Транслит = СтроковыеФункцииКлиентСервер.ТранслитерироватьСтроку(Объект.Description);
	
	Префикс = "";
	Если ЗначениеЗаполнено(Объект.Кластер) Тогда
		РеквизитыКластера = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Кластер, "ПрефиксИмениБазы");
		Префикс = СтроковыеФункцииКлиентСервер.ТранслитерироватьСтроку(РеквизитыКластера.ПрефиксИмениБазы);
	КонецЕсли;
	
	ИмяБазы = Транслит;
	Если Не ПустаяСтрока(Префикс) Тогда
		Если ПустаяСтрока(Транслит) Тогда
			ИмяБазы = Префикс;
		Иначе
			ИмяБазы = Префикс + "_" + Транслит;
		КонецЕсли;
	КонецЕсли;
	
	Объект.ИмяБазыНаСервере = ИмяБазы;
	
КонецПроцедуры

#КонецОбласти