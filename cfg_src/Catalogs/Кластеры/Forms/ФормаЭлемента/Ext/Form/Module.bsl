&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЭтоНовыйОбъект() Тогда

		Если Не ЗначениеЗаполнено(Объект.ТипСУБД) Тогда
			Объект.ТипСУБД = Перечисления.ТипыСУБД.MSSQL;
		КонецЕсли;

		Если Объект.КоличествоВременныхБаз = 0 Тогда
			Объект.КоличествоВременныхБаз = 5;
		КонецЕсли;

		Объект.ИспользоватьДляВременныхБаз = Истина;

	КонецЕсли;

КонецПроцедуры

