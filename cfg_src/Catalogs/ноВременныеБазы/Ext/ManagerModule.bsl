#Область ПрограммныйИнтерфейс

// Находит свободную временную базу указанного кластера.
// 
// Параметры:
// 	Кластер - СправочникСсылка.ноКластеры - кластер, в котором ищется свободная база
// Возвращаемое значение:
// 	СправочникСсылка.ноВременныеБазы, Неопределено - ссылка на свободную временную базу
Функция НайтиСвободную(Знач Кластер) Экспорт

	Если Не ЗначениеЗаполнено(Кластер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВременныеБазы.Ссылка
	|ИЗ
	|	Справочник.ноВременныеБазы КАК ВременныеБазы
	|ГДЕ
	|	ВременныеБазы.Кластер = &Кластер
	|	И ВременныеБазы.Состояние = ЗНАЧЕНИЕ(Перечисление.ноСостоянияВременныхБаз.Свободна)
	|УПОРЯДОЧИТЬ ПО
	|	ВременныеБазы.КоличествоИспользований,
	|	ВременныеБазы.Код
	|АВТОУПОРЯДОЧИВАНИЕ";

	Запрос.УстановитьПараметр("Кластер", Кластер);

	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Помечает временную базу как занятую указанной версией хранилища.
// 
// Параметры:
// 	ВременнаяБаза - СправочникСсылка.ноВременныеБазы - захватываемая база
// 	ВерсияХранилища - СправочникСсылка.ВерсииХранилища - версия, для которой занята база
Процедура Занять(Знач ВременнаяБаза, Знач ВерсияХранилища = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ВременнаяБаза) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВерсияХранилища) Тогда
		ВерсияХранилища = Справочники.ВерсииХранилища.ПустаяСсылка();
	КонецЕсли;

	Объект = ВременнаяБаза.ПолучитьОбъект();
	Объект.Состояние = Перечисления.ноСостоянияВременныхБаз.Занята;
	Объект.ВерсияХранилища = ВерсияХранилища;
	Объект.ДатаЗанятия = ТекущаяДата();
	Объект.КоличествоИспользований = Объект.КоличествоИспользований + 1;
	Объект.Записать();

КонецПроцедуры

// Освобождает временную базу.
// 
// Параметры:
// 	ВременнаяБаза - СправочникСсылка.ноВременныеБазы - освобождаемая база
Процедура Освободить(Знач ВременнаяБаза) Экспорт

	Если Не ЗначениеЗаполнено(ВременнаяБаза) Тогда
		Возврат;
	КонецЕсли;

	Объект = ВременнаяБаза.ПолучитьОбъект();
	Если Объект.Состояние = Перечисления.ноСостоянияВременныхБаз.ТребуетПересоздания Тогда
		Возврат;
	КонецЕсли;
	Объект.Состояние = Перечисления.ноСостоянияВременныхБаз.Свободна;
	Объект.ВерсияХранилища = Справочники.ВерсииХранилища.ПустаяСсылка();
	Объект.ДатаПоследнегоОсвобождения = ТекущаяДата();
	Объект.Записать();

КонецПроцедуры

// Помечает временную базу как требующую пересоздания.
// 
// Параметры:
// 	ВременнаяБаза - СправочникСсылка.ноВременныеБазы - база, требующая пересоздания
Процедура ПометитьПересоздание(Знач ВременнаяБаза) Экспорт

	Если Не ЗначениеЗаполнено(ВременнаяБаза) Тогда
		Возврат;
	КонецЕсли;

	Объект = ВременнаяБаза.ПолучитьОбъект();
	Объект.Состояние = Перечисления.ноСостоянияВременныхБаз.ТребуетПересоздания;
	Объект.ВерсияХранилища = Справочники.ВерсииХранилища.ПустаяСсылка();
	Объект.Записать();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
