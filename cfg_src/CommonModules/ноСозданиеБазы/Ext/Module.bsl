#Область ПрограммныйИнтерфейс

// Создает серверную информационную базу по данным элемента справочника "Временные базы".
// 
// Параметры:
// 	ВременнаяБаза - СправочникСсылка.ноВременныеБазы - элемент пула временных баз
// 
// Возвращаемое значение:
// 	Структура - результат создания:
// 		* Успешно - Булево - признак успешного создания
// 		* Описание - Строка - сообщение о результате
// 		* КодВозврата - Число - код возврата процесса 1cv8
Функция СоздатьБазу(ВременнаяБаза) Экспорт
	
	Результат = Новый Структура("Успешно, Описание, КодВозврата");
	Результат.Успешно = Ложь;
	Результат.КодВозврата = 0;
	
	ИменаРеквизитовБазы = Новый Структура("Кластер, ИмяБазыНаСервере");
	РеквизитыБазы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВременнаяБаза, ИменаРеквизитовБазы);
	
	Если Не ЗначениеЗаполнено(РеквизитыБазы.Кластер) Тогда
		Результат.Описание = НСтр("ru='Не указан кластер временных баз.'");
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РеквизитыБазы.ИмяБазыНаСервере) Тогда
		Результат.Описание = НСтр("ru='Не указано имя базы на сервере.'");
		Возврат Результат;
	КонецЕсли;
	
	Параметры = ПодготовитьПараметрыСоздания(РеквизитыБазы.Кластер, РеквизитыБазы.ИмяБазыНаСервере);
	
	СтрокаПараметров = СтрокаКомандыСозданияБазы(Параметры);
	
	ФайлПараметров = Новый ТекстовыйДокумент;
	ФайлПараметров.УстановитьТекст(СтрокаПараметров);
	Если ЭтоWindowsСервер Тогда
		ФайлПараметров.Записать(Параметры.ФайлПараметровПакетнойОперации, КодировкаТекста.ANSI);
	Иначе
		ФайлПараметров.Записать(Параметры.ФайлПараметровПакетнойОперации, КодировкаТекста.UTF8);
	КонецЕсли;
	
	СтрокаКоманды = """%КаталогИсполняемогоФайла%1cv8"" /@ ""%ФайлПараметровПакетнойОперации%""";
	СтрокаКоманды = СтрЗаменить(СтрокаКоманды, "%КаталогИсполняемогоФайла%", Параметры.КаталогИсполняемогоФайла);
	СтрокаКоманды = СтрЗаменить(СтрокаКоманды, "%ФайлПараметровПакетнойОперации%", Параметры.ФайлПараметровПакетнойОперации);
	
	КодВозврата = Неопределено;
	ЗапуститьПриложение(СтрокаКоманды, Параметры.КаталогИсполняемогоФайла, Истина, КодВозврата);
	
	Результат.КодВозврата = ?(КодВозврата = Неопределено, -1, КодВозврата);
	
	КодРезультата = ПрочитатьФайлРезультата(Параметры.ИмяФайлаРезультатов);
	
	Если КодВозврата <> 0 Или КодРезультата <> 0 Тогда
		Результат.Описание = НСтр("ru='Не удалось создать базу. Код возврата: %1, код результата: %2.
			|Подробности в логе: %3'");
		Результат.Описание = СтрЗаменить(Результат.Описание, "%1", Строка(Результат.КодВозврата));
		Результат.Описание = СтрЗаменить(Результат.Описание, "%2", Строка(КодРезультата));
		Результат.Описание = СтрЗаменить(Результат.Описание, "%3", Параметры.ИмяФайлаЛогов);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успешно = Истина;
	Результат.Описание = НСтр("ru='База «%1» успешно создана.'");
	Результат.Описание = СтрЗаменить(Результат.Описание, "%1", РеквизитыБазы.ИмяБазыНаСервере);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготавливает параметры создания серверной базы: реквизиты кластера, каталоги и имена файлов.
// 
// Параметры:
// 	Кластер      - СправочникСсылка.ноКластеры - кластер временных баз
// 	ИмяБазыСервере - Строка - имя базы на сервере
// 
// Возвращаемое значение:
// 	Структура - параметры создания базы
Функция ПодготовитьПараметрыСоздания(Кластер, ИмяБазыСервере)
	
	Параметры = Новый Структура;
	
	ИменаРеквизитовКластера = Новый Структура("АдресСервера, ТипСУБД, СерверСУБД, ИмяПользователяСУБД, ПарольПользователяСУБД,
		| ЭталонВременнойБазы");
	РеквизитыКластера = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Кластер, ИменаРеквизитовКластера);
	
	Параметры.Вставить("АдресСервера", РеквизитыКластера.АдресСервера);
	Параметры.Вставить("ТипСУБД", РеквизитыКластера.ТипСУБД);
	Параметры.Вставить("СерверСУБД", РеквизитыКластера.СерверСУБД);
	Параметры.Вставить("ИмяПользователяСУБД", РеквизитыКластера.ИмяПользователяСУБД);
	Параметры.Вставить("ПарольПользователяСУБД", РеквизитыКластера.ПарольПользователяСУБД);
	Параметры.Вставить("ЭталонВременнойБазы", РеквизитыКластера.ЭталонВременнойБазы);
	Параметры.Вставить("ИмяКластера", Строка(Кластер));
	Параметры.Вставить("ИмяБазы", ИмяБазыСервере);
	Параметры.Вставить("КаталогИсполняемогоФайла", КаталогИсполняемогоФайлаПлатформы());
	
	КаталогВременныхФайлов = КаталогВременныхФайлов();
	КаталогВременныхФайлов = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВременныхФайлов);
	
	УникальныйКлюч = Новый УникальныйИдентификатор;
	ИмяФайлов = "no_create_base_" + Строка(УникальныйКлюч);
	
	Параметры.Вставить("ФайлПараметровПакетнойОперации", КаталогВременныхФайлов + ИмяФайлов + ".txt");
	Параметры.Вставить("ИмяФайлаРезультатов", КаталогВременныхФайлов + ИмяФайлов + "_result.txt");
	Параметры.Вставить("ИмяФайлаЛогов", КаталогВременныхФайлов + ИмяФайлов + "_log.txt");
	
	Возврат Параметры;
	
КонецФункции

// Формирует текст файла параметров пакетной операции создания серверной базы.
// 
// Параметры:
// 	Параметры - Структура - параметры создания базы
// 
// Возвращаемое значение:
// 	Строка - текст параметров запуска 1cv8
Функция СтрокаКомандыСозданияБазы(Параметры)
	
	СтрокаСоздания = СтрокаСозданияСервернойБазы(Параметры);
	
	СтрокаПараметров = СтрокаСоздания + " /L ru /VL ru";
	
	Если ЗначениеЗаполнено(Параметры.ЭталонВременнойБазы) Тогда
		СтрокаПараметров = СтрокаПараметров + " /UseTemplate ""%ЭталонВременнойБазы%""";
		СтрокаПараметров = СтрЗаменить(СтрокаПараметров, "%ЭталонВременнойБазы%", Параметры.ЭталонВременнойБазы);
	КонецЕсли;
	
	СтрокаПараметров = СтрокаПараметров + "
		|/DumpResult ""%ИмяФайлаРезультатов%""
		|/Out ""%ИмяФайлаЛогов%"" -NoTruncate";
	
	СтрокаПараметров = СтрЗаменить(СтрокаПараметров, "%ИмяФайлаРезультатов%", Параметры.ИмяФайлаРезультатов);
	СтрокаПараметров = СтрЗаменить(СтрокаПараметров, "%ИмяФайлаЛогов%", Параметры.ИмяФайлаЛогов);
	
	Возврат СтрокаПараметров;
	
КонецФункции

// Формирует команду CREATEINFOBASE для создания серверной базы из параметров кластера.
// 
// Параметры:
// 	Параметры - Структура - параметры создания базы
// 
// Возвращаемое значение:
// 	Строка - команда CREATEINFOBASE для серверной базы
Функция СтрокаСозданияСервернойБазы(Параметры)
	
	Если Параметры.ТипСУБД = Перечисления.ноТипыСУБД.PostgreSQL Тогда
		ИмяСУБД = "PostgreSQL";
	Иначе
		ИмяСУБД = "MSSQL";
	КонецЕсли;
	
	СтрокаСоздания = "CREATEINFOBASE Srvr=""%АдресСервера%"";Ref=""%ИмяКластера%"";"
		+ "DBMS=" + ИмяСУБД + ";DBSrvr=""%СерверСУБД%"";DBUID=""%ИмяПользователяСУБД%"";"
		+ "DBPwd=""%ПарольПользователяСУБД%"";DB=""%ИмяБазы%"";Locale=ru_RU";
	
	СтрокаСоздания = СтрЗаменить(СтрокаСоздания, "%АдресСервера%", Параметры.АдресСервера);
	СтрокаСоздания = СтрЗаменить(СтрокаСоздания, "%ИмяКластера%", Параметры.ИмяКластера);
	СтрокаСоздания = СтрЗаменить(СтрокаСоздания, "%СерверСУБД%", Параметры.СерверСУБД);
	СтрокаСоздания = СтрЗаменить(СтрокаСоздания, "%ИмяПользователяСУБД%", Параметры.ИмяПользователяСУБД);
	СтрокаСоздания = СтрЗаменить(СтрокаСоздания, "%ПарольПользователяСУБД%", Параметры.ПарольПользователяСУБД);
	СтрокаСоздания = СтрЗаменить(СтрокаСоздания, "%ИмяБазы%", Параметры.ИмяБазы);
	
	Возврат СтрокаСоздания;
	
КонецФункции

// Возвращает каталог, в котором находится исполняемый файл 1cv8 на сервере.
// 
// Возвращаемое значение:
// 	Строка - каталог исполняемого файла 1cv8 с завершающим разделителем пути
Функция КаталогИсполняемогоФайлаПлатформы()
	
	КаталогИсполняемогоФайла = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогПрограммы());
	
	ПутьКВерсиямПлатформыНаСервере = Константы.ПутьКВерсиямПлатформыНаСервере.Получить();
	Если ЗначениеЗаполнено(ПутьКВерсиямПлатформыНаСервере) Тогда
		
		СисИнфо = Новый СистемнаяИнформация;
		ПутьКВерсиямПлатформыНаСервере = СтрЗаменить(ПутьКВерсиямПлатформыНаСервере,
			"%ВерсияПлатформы%", СисИнфо.ВерсияПриложения);
		
		Файл = Новый Файл(ПутьКВерсиямПлатформыНаСервере);
		Если Файл.Существует() Тогда
			КаталогИсполняемогоФайла = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПутьКВерсиямПлатформыНаСервере);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КаталогИсполняемогоФайла;
	
КонецФункции

// Читает код результата из файла, созданного 1cv8 (/DumpResult).
// 
// Параметры:
// 	ИмяФайлаРезультатов - Строка - путь к файлу результата
// 
// Возвращаемое значение:
// 	Число - код результата
Функция ПрочитатьФайлРезультата(ИмяФайлаРезультатов)
	
	Результат = 1;
	ФайлРезультата = Новый ТекстовыйДокумент();
	Попытка
		ФайлРезультата.Прочитать(ИмяФайлаРезультатов);
		ТекстРезультата = ФайлРезультата.ПолучитьТекст();
		Если ПустаяСтрока(ТекстРезультата) Тогда
			Результат = 99999;
		ИначеЕсли СокрЛП(ТекстРезультата) = "0" Тогда
			Результат = 0;
		Иначе
			Результат = Число(ТекстРезультата);
		КонецЕсли;
	Исключение
		Результат = 100000;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти